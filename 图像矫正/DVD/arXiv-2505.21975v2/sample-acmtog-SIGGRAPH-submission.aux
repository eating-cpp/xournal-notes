\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Framework of the proposed DvD.} Given a warped document as input, DvD generates latent variables $m$ to characterize the mapping for deformation rectification. We leverage a compound condition $c_t$: the features for raw document images $f_d$, document foreground mask $f_m$, text-lines $f_l$, and the time-variant condition of the intermediate result $r_t$, respectively. We visualize the reverse denoise generation process in the right pink region.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:img2}{{2}{3}{\textbf {Framework of the proposed DvD.} Given a warped document as input, DvD generates latent variables $m$ to characterize the mapping for deformation rectification. We leverage a compound condition $c_t$: the features for raw document images $f_d$, document foreground mask $f_m$, text-lines $f_l$, and the time-variant condition of the intermediate result $r_t$, respectively. We visualize the reverse denoise generation process in the right pink region}{figure.caption.4}{}}
